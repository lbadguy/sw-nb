{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sw-nb",
  "main": "worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "DONGCHEDI_CACHE",
      "id": "a958bcd6382c4f469f077c40d0997d5b"
    }
  ],
  "vars": {
    "DONGCHEDI_USER_ID": "485359118462679"
  },
  "triggers": {
    "crons": ["*/10 * * * *", "17 20 * * *"]
  }
}
